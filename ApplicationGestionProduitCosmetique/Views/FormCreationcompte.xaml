<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormCreationcompte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        mc:Ignorable="d"
        Title="FormCreationcompte" Height="450" Width="700">

    <Window.Background>
        <ImageBrush ImageSource="/Resources/Images/img9.jpg" Stretch="Uniform" />
    </Window.Background>

    <Grid>
        <Rectangle Fill="White" Opacity="0.85" RadiusX="20" RadiusY="20"
               Width="450" Height="320"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Width="450" Height="320"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="20">
            <TextBlock x:Name="tbTitre" Text="Information d'un client" 
                   FontWeight="Bold" FontSize="18"
                   HorizontalAlignment="Center" Margin="0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                <Label Content="Nom" Width="150" FontSize="16" FontWeight="Bold"/>
                <TextBox x:Name="txtNom" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Margin="8">
                <Label Content="Mot de passe" Width="150" FontSize="16" FontWeight="Bold"></Label>
                <PasswordBox x:Name="txtPassword" Width="200"/>
            </StackPanel>
            <StackPanel Margin="5" HorizontalAlignment="Center">
                <Button x:Name="btnCreecompte" Content="Créer compte" Width="100" Margin="10" Background="Green" Click="btnCreecompte_Click"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>