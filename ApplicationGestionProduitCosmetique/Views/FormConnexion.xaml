<Window x:Class="ApplicationGestionProduitCosmetique.FormConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="550" Width="800">

    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="143*"/>
        </Grid.ColumnDefinitions>
        <Border  Width="1000" Height="500" Background="White" CornerRadius="20"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Margin="65,65,0,0" Padding="20" BorderBrush="#D3D3D3" BorderThickness="1" Grid.Column="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Connexion Utilisateur" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Type d'utilisateur:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbTypeUtilisateur" Width="150" SelectionChanged="cmbTypeUtilisateur_SelectionChanged">
                        <ComboBoxItem Content="Client" IsSelected="True"/>
                        <ComboBoxItem Content="Vendeur" />
                        <ComboBoxItem Content="Manager"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Label Content="Nom:" Width="120" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" Margin="3">
                        <TextBox x:Name="txtNom" Height="30" Width="200"/>
                        <TextBlock x:Name="lblErreurNom" Width="200" Foreground="Red" Visibility="Collapsed"></TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Label Name="lblCode" Content="Code:" Width="120" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Orientation="Vertical" Margin="3">
                        <TextBox x:Name="txtCode" Width="200" Height="30" Visibility="Collapsed"/>
                        <TextBlock x:Name="lblErreurCode" Foreground="Red" Visibility="Collapsed"></TextBlock>
                    </StackPanel>
                </StackPanel>
               
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Label Content="Mot de passe:" Width="120" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" Margin="3">
                        <PasswordBox x:Name="txtPassword" Width="200" Height="30"/>
                        <TextBlock x:Name="lblErreurPassword" Foreground="Red" Visibility="Collapsed"></TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <Button Content="Se connecter" Width="150" Background="Green" Foreground="White"
                        HorizontalAlignment="Center" Margin="10" Click="btnConnecter_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="lblMessageErreur" Foreground="Red" FontWeight="Bold"
                    HorizontalAlignment="Center" Width="500" Height="30" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
