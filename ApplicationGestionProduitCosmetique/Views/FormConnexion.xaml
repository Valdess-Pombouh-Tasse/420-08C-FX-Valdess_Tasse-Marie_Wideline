<Window x:Class="ApplicationGestionProduitCosmetique.FormConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="550" Width="800">

    <Grid Background="#F0F0F0">
        <Border Width="500" Height="400" Background="White" CornerRadius="20"
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Margin="0,20,0,0" Padding="20" BorderBrush="#D3D3D3" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Connexion Utilisateur" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Type d'utilisateur:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbTypeUtilisateur" Width="150">
                        <ComboBoxItem Content="Vendeur" IsSelected="True"/>
                        <ComboBoxItem Content="Manager"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Label Content="Nom:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtNom" Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Label Content="Code:" Width="120" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCode" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                    <Label Content="Mot de passe:" Width="120" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="txtPassword" Width="200"/>
                </StackPanel>
                <Button Content="Se connecter" Width="150" Background="Green" Foreground="White"
                        HorizontalAlignment="Center" Margin="20,10,20,0" Click="btnConnecter_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
