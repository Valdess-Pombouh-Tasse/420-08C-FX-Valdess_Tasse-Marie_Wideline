<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormVideo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vidéo Cosmétique" Height="500" Width="850" Background="#FFFDF8FA">
    <Window.Resources>
        <!-- Style bouton rose pâle -->
        <Style x:Key="RosePaleButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF5E6F0"/>
            <Setter Property="Foreground" Value="#80003C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="✨ Présentation de l'appli en Vidéo ✨"
                   FontSize="24" FontWeight="Bold" Foreground="#80003C"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Vidéo -->
        <Border Grid.Row="1" BorderBrush="#FFE0BFE6" BorderThickness="2" CornerRadius="12" Padding="4">
            <MediaElement x:Name="mediaCosmetic"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="Uniform"
                          Source="Resources/Videos/videoFianleprojet.mp4"
                          Margin="0"/>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="▶ Lire" Style="{StaticResource RosePaleButton}" Click="BtnLire_Click"/>
            <Button Content="⏸ Pause" Style="{StaticResource RosePaleButton}" Click="BtnPause_Click"/>
            <Button Content="⏹ Arrêter" Style="{StaticResource RosePaleButton}" Click="BtnStop_Click"/>
        </StackPanel>
    </Grid>
</Window>
