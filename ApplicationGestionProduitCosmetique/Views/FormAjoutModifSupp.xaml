<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormAjoutModifSupp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        mc:Ignorable="d"
        Title="FormAjoutModifSupp" Height="450" Width="400" Loaded="Window_Loaded">
    <StackPanel Width="300" HorizontalAlignment="Center">
        <TextBlock x:Name="tbTitre" Text="Modification d'un utilisateur" FontWeight="Bold"  HorizontalAlignment="Center" Margin="0,20" FontSize="18"></TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Code" Width="100" FontSize="14"></Label>
            <TextBox x:Name="txtCode" Width="100"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Nom" Width="100" FontSize="14"></Label>
            <TextBox x:Name="txtNom" Width="200"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Mot de Passe" Width="100" FontSize="14"></Label>
            <PasswordBox x:Name="txtPassword" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Role" Width="100" FontSize="14"></Label>
            <ComboBox Name="cboRole" Width="200"></ComboBox>
        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnValider" Content="Valider" Width="100"  Margin="5,0" Click="btnValider_Click"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="100"  Margin="5,0" Click="btnAnnuler_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
