<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="FormApplication" Height="570" Width="800" Loaded="Window_Loaded">
    <Border>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="393*"/>
                <ColumnDefinition Width="0*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="10,0,0,10"
                 Grid.Column="0" Grid.Row="0" Margin="0,0,351,0" Grid.ColumnSpan="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="AliceBlue" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                        Height="60" Grid.Row="0">
                        <TextBlock FontWeight="ExtraBold" Foreground="Indigo" FontSize="30" FontFamily="Cooper Black" Margin="10"><Run Text="Cosmetic"/><Run Text=" Shop"/></TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Catalogue" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color2}" Command="{Binding ShowArticleChoisirViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Articles Choisis" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleChoisirViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Articles Commandé" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Margin="15,1,195,20" Background="AliceBlue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="Black" Text="Deconnexion" Style="{StaticResource menuButtonText}"/>
                            <fa:IconImage Icon="SignOut"  Style="{StaticResource menuButtonIcon}"/>

                        </StackPanel>
                    </RadioButton>
                </Grid>

            </Border>

            <Border CornerRadius="0,10,10,0" Grid.Row="0" Margin="260,0,0,0" Grid.Column="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="AliceBlue" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="pnlbar" Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Background="Transparent" Margin="0,0,5,0">
                        <Button x:Name="btnFermer" Style="{StaticResource controlButton}" Tag="{StaticResource Color4}" Click="btnFermer_Click">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>

                        </Button>
                        <Button x:Name="btnMaxFenetrer" Style="{StaticResource controlButton}" Tag="{StaticResource Color6}" Click="btnMaxFenetrer_Click">
                            <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>

                        </Button>
                        <Button x:Name="btnMinFenetrer" Style="{StaticResource controlButton}" Tag="{StaticResource Color8}" Click="btnMinFenetrer_Click">
                            <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource controlButtonIcon}"/>

                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconImage Icon="Home" Height="20" Width="20" Foreground="Black" Margin="35,0,10,0"/>
                            <TextBlock Text="{Binding Titre}" Foreground="Black" FontSize="16" FontFamily="Montserrat" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch"  FlowDirection="RightToLeft" Margin="10,0,30,0">

                            <TextBlock x:Name="txtUtilisateurClient" Text="Utilisateur" Foreground="Black" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>

                            <Ellipse Height="35" Width="35" Stroke="White" StrokeThickness="2" Margin="10,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Resources/Images/ImagesIcons/iconUtilisateur.jpeg"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,75,0" x:Name="spAjouterProduit" Orientation="Horizontal" >
                                <TextBox x:Name="txtRechercher" Width="250" Height="25" Margin="0,0,5,0"/>
                                <ComboBox Name="cboCategories" Width="150" Margin="5,5,5,5">

                                </ComboBox>
                                <Button x:Name="btnRechercherProduit" BorderThickness="0" Background="White">
                                    <Image Source="/Resources/Images/ImagesIcons/search.png" Width="25" Margin="5"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3">
                        <StackPanel Margin="15">
                            <Label Name="lblTitre" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="380" Margin="2">
                                <WrapPanel Name="wpProduit" Orientation="Horizontal">

                                </WrapPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <!--<ContentControl Content="{Binding CorpsCourrantView}" Grid.Row="3" Margin="20,20,20,34"/>-->
                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
