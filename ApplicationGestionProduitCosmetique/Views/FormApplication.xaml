<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="FormApplication" Height="450" Width="800">
    <Border>
        <Grid >

    <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="0*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border CornerRadius="10,0,0,10"
            Grid.Column="0" Grid.Row="0" Margin="0,0,351,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Color="AliceBlue" Offset="0"/>
                <GradientStop Color="AliceBlue" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <StackPanel Orientation="Horizontal"
                        Height="35"
                        Margin="15,25,0,40" Grid.Row="0">
                
                <TextBlock FontWeight="Bold" Foreground="#C46E4E" FontSize="20" FontFamily="Cooper Black" Height="27"><Run Text="Dream Wo"/><Run Language="fr-ca" Text="r"/><Run Text="ld App"/></TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <RadioButton Command="{Binding ShowAccueilViewModel}" >
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage Icon="Home" />
                        <TextBlock Text="Catalogue" Foreground="Black"/>
                    </StackPanel>
                </RadioButton>
                        <RadioButton Command="{Binding ShowArticleChoisirViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ShoppingCart" />
                                <TextBlock Text="Articles Choisis" Foreground="Black" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>




            <RadioButton Grid.Row="2" Tag="black" Margin="15,22,130,21" Background="AliceBlue">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="Black" Text="Deconnexion" />
                    <fa:IconImage Icon="SignOut"  />

                </StackPanel>
            </RadioButton>
        </Grid>




    </Border>

    <Border CornerRadius="0,10,10,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="274,0,0,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="AliceBlue" Offset="0"/>
                <GradientStop Color="AliceBlue" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*" />
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="pnlbar" Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Background="Transparent" Margin="0,0,5,0">
                <Button x:Name="btnFermer">
                    <fa:IconImage Icon="Xmark"/>

                </Button>
                <Button x:Name="btnMaxFenetrer">
                    <fa:IconImage Icon="Square"/>

                </Button>
                <Button x:Name="btnMinFenetrer">
                    <fa:IconImage Icon="WindowMinimize" Width="12"/>

                </Button>
            </StackPanel>
            <Grid Grid.Row="1">

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconImage Icon="{Binding Icon}" Height="20" Width="20" Foreground="Black" Margin="35,0,10,0"/>
                    <TextBlock Text="{Binding Titre}" Foreground="Black" FontSize="16" FontFamily="Montserrat" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch"  FlowDirection="RightToLeft" Margin="10,0,30,0">

                    <TextBlock x:Name="txtUtilisateurClient" Text="Utilisateur" Foreground="Black" FontFamily="Montserrat" FontSize="14" VerticalAlignment="Center"/>

                    <Ellipse Height="35" Width="35" Stroke="White" StrokeThickness="2" Margin="10,0,10,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Resources/Images/ImagesIcons/iconUtilisateur.jpeg"/>
                        </Ellipse.Fill>
                    </Ellipse>


                </StackPanel>
            </Grid>

            <ContentControl Content="{Binding CorpsCourrantView}" Grid.Row="2" Margin="20,20,20,34"/>
        </Grid>

    </Border>


</Grid>

    </Border>
    
</Window>
