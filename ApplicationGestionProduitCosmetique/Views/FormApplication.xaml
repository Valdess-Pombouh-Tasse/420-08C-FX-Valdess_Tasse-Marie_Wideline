<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormApplication"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
       Title="Cosmétique Shop" Height="700" Width="1000">
    <Grid Margin="0,0,-20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="332"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Background="AliceBlue" Grid.Column="0" CornerRadius="10,0,0,10"  Margin="-18,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
                    <TextBlock  FontWeight="ExtraBold" Foreground="Indigo" FontSize="21" FontFamily="Cooper Black" Margin="0 0 0 20"><Run Text="🧴 Cosmetic"/><Run Text=" Shop"/></TextBlock>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Catalogue" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleCommandesViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ClipboardList" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Articles Commandés" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color8}" Command="{Binding ShowFactureViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoice" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Mes factures" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Déconnexion -->
                <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Background="AliceBlue" Margin="15,10,20,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Déconnexion" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        <fa:IconImage Icon="SignOut" Style="{StaticResource menuButtonIcon}"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>



        <!-- Liste des produits -->
        <StackPanel Grid.Column="1" Margin="20">
            <StackPanel Margin="0,10,30,3" x:Name="spAjouterProduit" Orientation="Horizontal" Grid.Row="0">
                <TextBox x:Name="txtRechercher" Width="200" Height="34" Margin="5,0" TextChanged="txtRechercher_TextChanged"/>
                <ComboBox Name="cboCategories" Width="150" Margin="5,0" >
                    <!-- Tu peux ajouter tes catégories ici si tu veux -->
                </ComboBox>
                <Button x:Name="btnRechercherProduit" BorderThickness="0" Background="White" Click="btnRechercherProduit_Click">
                    <Image Source="/Resources/Images/ImagesIcons/search.png" Width="25" Margin="5"/>
                </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="525" Margin="2" Width="465">
                <WrapPanel x:Name="wpProduits" Orientation="Horizontal">

                </WrapPanel>
            </ScrollViewer>

        </StackPanel>

        <!-- Panier -->
        <StackPanel Grid.Column="2" Background="#FFF4F4F4" Margin="10,0,0,0">
            <TextBlock Text="🛒 Mon Panier" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
            <Border Height="346" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="10" Width="321">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="290" Margin="2">
                    <WrapPanel Name="wpProduitPanier" Orientation="Horizontal">
                        <!-- Produits ajoutés dynamiquement -->
                    </WrapPanel>
                </ScrollViewer>
            </Border>

            <!-- Totaux -->
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Sous-Total" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblSousTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="TPS" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblTPS" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="TVQ" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblTVQ" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Total" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>

            </StackPanel>
            <!-- Boutons de contrôle -->
            <DockPanel>
                <Button x:Name="btnNouvelleFacture" Background="White" BorderThickness="0" DockPanel.Dock="Left" Click="btnNouvelleFacture_Click_1">
                    <Image Source="/Resources/Images/ImagesIcons/new.png" Width="25" Margin="5"/>
                </Button>
                <Button x:Name="btnPayer"  Content="Payer" Width="106" Background="#FF4CAF50" Foreground="White" Margin="5" Click="btnPayer_Click" Height="33" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>