<Window x:Class="ApplicationGestionProduitCosmetique.Views.Factures"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="Mes Factures" Height="550" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Background="AliceBlue" Grid.Column="0" CornerRadius="10,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
                    <TextBlock FontWeight="Bold" Foreground="Indigo" FontSize="24" FontFamily="Cooper Black">
                        <Run Text="Cosmetic"/><Run Text=" Shop"/>
                    </TextBlock>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Catalogue" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color2}" Command="{Binding ShowArticleChoisirViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Articles Choisis" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleCommandesViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ClipboardList" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Articles Commandés" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color8}" Command="{Binding ShowFactureViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoice" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Mes factures" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Déconnexion -->
                <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Background="AliceBlue" Margin="15,10,20,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Déconnexion" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        <fa:IconImage Icon="SignOut" Style="{StaticResource menuButtonIcon}"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="Historique des factures"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2E2E2E"
                       Margin="0,0,0,15"/>

            <!-- Tableau des factures -->
            <ListBox x:Name="lstFactures" Grid.Row="1" Margin="0,0,0,40"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding ListeFactures}">

                <!-- Template des factures -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5" Background="White">
                            <StackPanel Orientation="Vertical">
                                <TextBlock FontWeight="Bold" FontSize="16" Text="{Binding NumeroFacture}" Foreground="DarkSlateBlue"/>
                                <TextBlock Text="{Binding DateFacture, StringFormat='Date : {0:dd/MM/yyyy}'}" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding NomClient}" FontSize="13" Foreground="Black"/>
                                <TextBlock Text="{Binding MontantTotal, StringFormat='Total : {0:C2}'}" FontSize="13" Foreground="DarkGreen"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bouton en bas -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Souhaitez-vous recevoir la facture par email ?" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="Oui" Margin="10,0" Click="BtnEnvoyerEmail_Click"/>
                    <Button Content="Non" Click="BtnFermer_Click"/>
                </StackPanel>

                <Button Content="Télécharger / Ouvrir" Width="160" Height="30" Click="BtnOuvrir_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
