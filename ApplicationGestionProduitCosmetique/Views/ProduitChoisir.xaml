<Window x:Class="ApplicationGestionProduitCosmetique.Views.ProduitChoisir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        mc:Ignorable="d"
        Title="ProduitChoisir" Height="450" Width="800" Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="189*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="7*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="lblliste" Width="200" FontWeight="Bold" Text="Panier" HorizontalAlignment="Center"  Margin="5" />

            <Grid Grid.Row="1" HorizontalAlignment="Right" Width="300" Height="61">


            </Grid>

            <StackPanel Grid.Row="2">
                <ListView   x:Name="lvListePanier" Background="Transparent" Grid.Row="2"   HorizontalContentAlignment="Stretch" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <Image Source="file:///C:/data-420-14B-FX/imagesProjet/test.jpg" Width="50" Height="50" Margin="5"/>

                                <Label Content="{Binding LstArticle.Nom}" Width="350" Margin="5,0,5,0" Foreground="DarkBlue" FontSize="16"/>
                                <Image  Source="/Resources/Images/ImagesIcons/minus.png"  Width="20" Margin="5" >
                                    <Image.ToolTip>
                                        <ToolTip Content="Diminuer la quantité"/>
                                    </Image.ToolTip>
                                </Image>
                                <TextBox Name="qwerty" Text="{Binding NbItem}"  Width="40" Height="25" Margin="5,0,5,0" TextAlignment="Center"/>
                                <Image  Source="/Resources/Images/ImagesIcons/plus.png"  Width="20" Margin="5">
                                    <Image.ToolTip>
                                        <ToolTip Content="Augmenter la quantité"/>
                                    </Image.ToolTip>
                                </Image>
                                <Image  Source="/Resources/Images/ImagesIcons/delete.png"  Width="20" Margin="5">
                                    <Image.ToolTip>
                                        <ToolTip Content="Supprimer l'article"/>
                                    </Image.ToolTip>
                                </Image>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </StackPanel>
            <TextBlock Grid.Row="3" x:Name="lblPrixSansTaxe" FontWeight="Bold" Text="Prix sans taxes" HorizontalAlignment="Center"  Margin="5" />
            <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,28,0" >
                <Button x:Name="btnEnreigistrerLst" Padding="10"  Content="Enregistrer" Click="btnEnreigistrerLst_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
