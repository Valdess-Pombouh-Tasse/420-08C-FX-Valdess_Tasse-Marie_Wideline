<Window x:Class="ApplicationGestionProduitCosmetique.Views.ProduitChoisir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="Panier" Height="650" Width="1000" Loaded="Window_Loaded">

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="393*"/>
                <ColumnDefinition Width="0*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Menu latéral -->
            <Border CornerRadius="10,0,0,10" Grid.Column="0" Grid.Row="0" Margin="0,0,351,0" Grid.ColumnSpan="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="AliceBlue" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Height="60" Grid.Row="0">
                        <TextBlock FontWeight="ExtraBold" Foreground="Indigo" FontSize="30" FontFamily="Cooper Black" Margin="10">
                            <Run Text="Cosmetic"/><Run Text=" Shop"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Text="Catalogue" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color2}" Command="{Binding ShowArticleChoisirViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Text="Articles Choisis" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleCommandesViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ClipboardList" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Text="Articles Commandés" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color8}" Command="{Binding ShowFactureViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="FileInvoice" Style="{StaticResource menuButtonIcon}" />
                                <TextBlock Text="Mes factures" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Margin="15,1,195,20" Background="AliceBlue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Déconnexion" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                            <fa:IconImage Icon="SignOut" Style="{StaticResource menuButtonIcon}"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Contenu principal -->
            <Border CornerRadius="0,10,10,0" Grid.Row="0" Margin="260,0,0,0" Grid.Column="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="AliceBlue" Offset="0"/>
                        <GradientStop Color="AliceBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border Width="520" Height="550" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel Margin="5">
                        <!-- Date et recherche facture -->
                        <TextBlock x:Name="lblDateFacture" Text="Date" HorizontalAlignment="Left" Margin="5" />
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="txtNoFacture" Width="200" Height="25" />
                            <Button x:Name="btnRechercherFacture" BorderThickness="0" Background="White">
                                <Image Source="/Resources/Images/ImagesIcons/search.png" Width="25" Margin="5"/>
                            </Button>
                        </StackPanel>

                        <!-- Affichage des items de la facture -->
                        <Border Height="250" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="230" Margin="2">
                                <WrapPanel Name="wpProduitPanier" Orientation="Horizontal">
                                    <!-- Produits ajoutés dynamiquement -->
                                </WrapPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Totaux -->
                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="Sous-Total" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblSousTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="TPS" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblTPS" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="TVQ" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblTVQ" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="Total" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>

                        </StackPanel>
                        <!-- Boutons de contrôle -->
                        <DockPanel>
                            <Button x:Name="btnNouvelleFacture" Background="White" BorderThickness="0" DockPanel.Dock="Left">
                                <Image Source="/Resources/Images/ImagesIcons/new.png" Width="25" Margin="5"/>
                            </Button>
                            <Button x:Name="btnPayer"  Content="Payer" Width="106" Background="#4169e1" Foreground="White" Margin="5" Click="btnPayer_Click" Height="33" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </Border>
        </Grid>
    </Border>
</Window>
