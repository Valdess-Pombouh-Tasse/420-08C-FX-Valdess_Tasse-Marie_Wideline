<Window x:Class="ApplicationGestionProduitCosmetique.Views.ProduitChoisir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="ProduitChoisir" Height="650" Width="1000" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Animation FadeIn pour les éléments -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:1" />
        </Storyboard>

        <!-- Animation Hover pour les boutons -->
        <Storyboard x:Key="HoverButton">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="-113,14,1,-119">
        <!-- Définition des colonnes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="323*"/>
            <ColumnDefinition Width="789*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu latéral -->
        <Border CornerRadius="10,0,0,10"
     Grid.Column="0" Grid.Row="0" Margin="0,0,1,31" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                    <GradientStop Color="AliceBlue" Offset="0"/>
                    <GradientStop Color="AliceBlue" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
            Height="60" Grid.Row="0">
                    <TextBlock FontWeight="ExtraBold" Foreground="Indigo" FontSize="30" FontFamily="Cooper Black" Margin="10"><Run Text="Cosmetic"/><Run Text=" Shop"/></TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" RenderTransformOrigin="0.5,0.552"/>
                            <TextBlock Text="Catalogue" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color2}" Command="{Binding ShowArticleChoisirViewModel}" Checked="RadioButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}" RenderTransformOrigin="0.5,0.546"/>
                            <TextBlock Text="Articles Choisis" Foreground="Black" Style="{StaticResource menuButtonText}"/>

                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleChoisirViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ShoppingCart" Style="{StaticResource menuButtonIcon}" RenderTransformOrigin="0.5,0.546"/>
                            <TextBlock Text="Articles Commandés" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color8}" Command="{Binding ShowFactureViewModel}" Checked="RadioButton_Checked_1">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoice" Style="{StaticResource menuButtonIcon}" RenderTransformOrigin="0.617,0.5"/>
                            <TextBlock Text="Mes factures" Foreground="Black" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Margin="15,1,195,20" Background="AliceBlue">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="Black" Text="Deconnexion" Style="{StaticResource menuButtonText}"/>
                        <fa:IconImage Icon="SignOut"  Style="{StaticResource menuButtonIcon}"/>
                    </StackPanel>
                </RadioButton>
                <Label x:Name="lblErreurUtilisateur" Visibility="Collapsed" Foreground="Red" />
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Border CornerRadius="0,10,10,0" Grid.Row="0" Margin="0,0,0,31" Grid.Column="1" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="AliceBlue" Offset="0"/>
                    <GradientStop Color="AliceBlue" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="20">
                <TextBlock Text="Panier" FontWeight="Bold" Foreground="#4169e1" FontSize="20" Margin="10"/>

                <Border Width="617" Height="558" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
                    <StackPanel Margin="5">
                        <!-- Date et recherche facture -->
                        <TextBlock x:Name="lblDateFacture" Text="Date" HorizontalAlignment="Left" Margin="5" />
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBox x:Name="txtNoFacture" Width="200" Height="25" />
                            <Button x:Name="btnRechercherFacture" BorderThickness="0" Background="White">
                                <Image Source="/Resources/Images/ImagesIcons/search.png" Width="25" Margin="5"/>
                            </Button>
                        </StackPanel>

                        <!-- Affichage des items de la facture -->
                        <Border Height="305" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-1,0,-1">
                                <WrapPanel Name="wpProduitPanier" Orientation="Horizontal">
                                    <!-- Produits ajoutés dynamiquement -->
                                </WrapPanel>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="Sous-Total" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblSousTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="TPS" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblTPS" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="TVQ" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblTVQ" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Label Content="Total" Margin="0,0,5,0" Height="26"/>
                                <TextBlock x:Name="lblTotal" Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Boutons de contrôle -->
                <DockPanel>
                    <Button x:Name="btnNouvelleFacture" Background="White" BorderThickness="0" DockPanel.Dock="Left">
                        <Image Source="/Resources/Images/ImagesIcons/new.png" Width="25" Margin="5"/>
                    </Button>
                    <Button x:Name="btnPayer"  Content="Payer" Background="#4169e1" Foreground="White" Padding="8" Click="btnPayer_Click" RenderTransformOrigin="1.706,-2.137" DockPanel.Dock="Right" Width="125" />
                </DockPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
