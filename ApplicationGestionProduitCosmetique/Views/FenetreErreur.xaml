<Window x:Class="ApplicationGestionProduitCosmetique.Classes.FenetreErreur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Classes"
        mc:Ignorable="d"
        Title="Erreur - Cosmetic Shop" Height="300" Width="500" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#FFF0F5">

    <Border CornerRadius="15" Background="White" Padding="15" BorderBrush="#FF69B4" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtErreur" TextWrapping="Wrap" Margin="20" FontSize="14"
                       Foreground="Black" TextAlignment="Center" HorizontalAlignment="Center"/>

            <Button Grid.Row="2" Content="OK" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Padding="10,5" Margin="10" Background="#FF69B4" Foreground="White"
                    FontSize="14" FontWeight="Bold" BorderThickness="0" Width="100"
                    Cursor="Hand" Click="Fermer_Click"/>
        </Grid>
    </Border>
</Window>