<Window x:Class="ApplicationGestionProduitCosmetique.Views.Base"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="Cosmetic Shop" Height="500" Width="1000">

    <Window.Resources>
        <Style x:Key="NoCircleRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="AliceBlue" Grid.Column="0" CornerRadius="10,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
                    <TextBlock FontWeight="Bold" Foreground="Indigo" FontSize="24" FontFamily="Cooper Black">
                <Run Text="Cosmetic"/><Run Text=" Shop"/>
                    </TextBlock>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color1}" Command="{Binding ShowAccueilViewModel}" Checked="RadioButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}" />
                            <TextBlock Text="Catalogue" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <!--<RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color2}" Command="{Binding ShowArticleChoisirViewModel}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconImage Icon="ShoppingCart" Style="{StaticResource }"/>
                    <TextBlock Text="Articles Choisis" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                </StackPanel>
            </RadioButton>-->

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color7}" Command="{Binding ShowArticleCommandesViewModel}" Checked="RadioButton_Checked_2">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ClipboardList" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Articles Commandés" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}" Tag="{StaticResource Color8}" Command="{Binding ShowFactureViewModel}" Checked="RadioButton_Checked_3">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoice" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Mes factures" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Déconnexion -->
                <RadioButton Grid.Row="2" Style="{StaticResource menuButton}" Tag="black" Background="AliceBlue" Margin="15,10,20,10" Checked="RadioButton_Checked_4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Déconnexion" Style="{StaticResource menuButtonText}" Foreground="Black"/>
                        <fa:IconImage Icon="SignOut" Style="{StaticResource menuButtonIcon}"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>


