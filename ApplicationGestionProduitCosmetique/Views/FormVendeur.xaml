<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormVendeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cosmetic Shop"
        Height="600" Width="950"
        Background="White"
        Loaded="Window_Loaded">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
            <RowDefinition Height="Auto"/>
            <!-- (réservé) -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Mes Produits -->
            <ColumnDefinition Width="3*"/>
            <!-- Tous les Produits -->
        </Grid.ColumnDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Gestion des Produits"
                   FontWeight="Bold"
                   Foreground="#4169e1"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- MES PRODUITS -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#f0f0f0"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>
                <TextBlock Text="Mes Produits"
                           FontWeight="Bold"
                           Foreground="#4169e1"
                           FontSize="18"
                           Margin="0,0,0,10"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Height="400">
                    <WrapPanel x:Name="wpMesProduits"
                               Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               Margin="5"/>
                </ScrollViewer>

                <!-- Boutons d'action -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="10">
                    <Button Name="btnAjouter"
                            Content="Ajouter"
                            Background="#4169e1"
                            Foreground="White"
                            Width="120"
                            Height="35"
                            Margin="5" Click="btnAjouter_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TOUS LES PRODUITS -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="#f8f8f8"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>
                <TextBlock Text="Tous les Produits"
                           FontWeight="Bold"
                           Foreground="#4169e1"
                           FontSize="18"
                           Margin="0,0,0,10"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Height="600">
                    <WrapPanel x:Name="wpProduits"
                               Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               Margin="5"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>