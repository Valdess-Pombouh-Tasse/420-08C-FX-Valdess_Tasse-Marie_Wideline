<Window x:Class="ApplicationGestionProduitCosmetique.FormVendeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"
        Title="FormVendeur" Height="600" Width="800" Loaded="Window_Loaded">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/Images/img9.jpg" Stretch="Uniform" />
    </Window.Background>
    
    <StackPanel Margin="10">
        <GroupBox Header="Liste des courses">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock  Text="NOM" FontWeight="Bold"  HorizontalAlignment="Left" Margin="0,0,265,0" />
                    <TextBlock  Text="COMPTE" FontWeight="Bold"  HorizontalAlignment="Left" Margin="0,0,130,0"/>
                    <TextBlock  Text="CODE" FontWeight="Bold"  HorizontalAlignment="Left" Margin="0,0,50,0" />
                </StackPanel>
                <StackPanel>
                    <ListBox x:Name="lstUtilisateurs"   Width="740" Height="200" VerticalAlignment="top" Margin="0,0,10,0" HorizontalAlignment="Left" FontFamily="Courier New"></ListBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Button x:Name="btnAjouterCourse"  Content="Ajouter"  Width="100" Height="25"/>
            <Button x:Name="btnModifierCourse"  Content="Modifier"  Width="100" Height="25" Margin="10,0,0,0"/>
            <Button x:Name="btnSupprimerCourse"   Content="Supprimer"  Width="100" Height="25" Margin="10,0,0,0"/>
        </StackPanel>

    </StackPanel>
</Window>
