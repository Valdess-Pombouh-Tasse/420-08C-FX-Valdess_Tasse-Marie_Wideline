<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormVendeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Produits" Height="600" Width="950" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Titre -->
        <TextBlock Grid.ColumnSpan="2" Text="Gestion des Produits" FontWeight="Bold" Foreground="#4169e1" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Liste des Produits -->
        <Border Grid.Row="1" Grid.Column="0" Background="#f0f0f0" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Liste des Produits" FontWeight="Bold" Foreground="#4169e1" FontSize="18" Margin="0,0,0,10"/>
                <ListBox Name="lbProduits" Height="400" Background="White" DisplayMemberPath="Nom" SelectionChanged="lbProduits_SelectionChanged"/>

                <!-- Boutons d'action -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Button Name="btnModifier" Content="Modifier" Background="#FFD700" Foreground="Black" Width="120" Height="35" Margin="5" Click="btnModifier_Click"/>
                    <Button Name="btnSupprimer" Content="Supprimer" Background="#FF6347" Foreground="White" Width="120" Height="35" Margin="5" Click="btnSupprimer_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Section Produits en Cartes -->
        <Border Grid.Row="1" Grid.Column="1" Background="#f8f8f8" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Affichage des Produits" FontWeight="Bold" Foreground="#4169e1" FontSize="18" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400">
                    <WrapPanel Name="wpProduits" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Formulaire d'Ajout/Modification -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#e6e6e6" Padding="15" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="5">
                    <TextBlock Text="Nom du produit"/>
                    <TextBox Name="txtNom" Width="200" Height="30"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Prix"/>
                    <TextBox Name="txtPrix" Width="120" Height="30"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Quantité"/>
                    <TextBox Name="txtQuantite" Width="120" Height="30"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Image"/>
                    <Button Name="btnImage" Content="Choisir Image" Width="120" Height="30" Click="btnImage_Click"/>
                </StackPanel>
                <Button Name="btnAjouter" Content="Ajouter" Background="#4169e1" Foreground="White" Width="120" Height="35" Margin="5" Click="btnAjouter_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>