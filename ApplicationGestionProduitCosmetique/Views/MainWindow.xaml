<Window x:Name="window" x:Class="ApplicationGestionProduitCosmetique.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"

        Title="Cosmetic Shop" Height="700" Width="900" Background="Pink" Loaded="Window_Loaded" Effect="{Binding WindowState, ElementName=window}" WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="16*"/>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="18*"/>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="126*"/>
            <ColumnDefinition Width="1203*"/>
            <ColumnDefinition Width="44*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de navigation -->
        <DockPanel Grid.Row="0" Background="#FFDDDDDD" Height="70" Grid.ColumnSpan="8">
            <TextBlock Text="Cosmetic Shop" FontSize="30" FontWeight="ExtraBold"
                       Foreground="Indigo" VerticalAlignment="Center"
                       Margin="20"/>
        </DockPanel>

        <!-- Contenu principal -->
        <Grid Grid.Row="1" Margin="1,15,15,15" Grid.Column="1" Grid.ColumnSpan="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Contenu central avec carte -->
            <Border Grid.Row="0" Padding="20" Background="White"
                    CornerRadius="15" Margin="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Width="350">
                        <TextBlock FontSize="24" FontWeight="Bold" Text="Bienvenue sur Cosmetic Shop"
                                   Margin="0,0,0,15" Foreground="#333"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Votre boutique dédiée aux produits cosmétiques adaptés à chaque type de peau. Découvrez nos gammes variées et prenez soin de vous avec des produits de qualité."
                                   Foreground="#666"/>
                    </StackPanel>

                    <MediaElement Name="videoPlayer" Width="400" Height="300" Source="pack://siteoforigin:,,,/Resources/Videos/video3.mp4"
                                  LoadedBehavior="Play" UnloadedBehavior="Stop" Stretch="UniformToFill" Margin="20,0,0,0" Opacity="0">
                        <MediaElement.Triggers>
                            <EventTrigger RoutedEvent="MediaElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </MediaElement.Triggers>
                    </MediaElement>
                </StackPanel>
            </Border>

            <!-- Boutons en dessous -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
                <Button Name="btnConnexion" Content="Se connecter" Width="95" Height="50"
                        Foreground="White" FontWeight="Bold" Background="#2196F3" 
                        Padding="10" Click="btnConnexion_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="2" CornerRadius="25" Width="{TemplateBinding Width}"
                                                Height="{TemplateBinding Height}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="10,36,0,18" Width="280" Grid.Row="2">
                <TextBlock x:Name="txtCreerCompte" Text="Vous n'avez pas de Compte?"
                           Foreground="DarkGray" FontSize="12" FontWeight="Medium" FontFamily="Montserrat"/>

                <Button x:Name="btnCreation" Cursor="Hand" Background="Transparent" BorderBrush="Transparent" FontFamily="Montserrat"
                        Click="btnCreation_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="txtbtnCreation" Text="Créer un Compte" FontSize="13" FontWeight="Medium"
                               FontFamily="Montserrat" Margin="9,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Ajout du ContentControl pour afficher les UserControls -->
        <ContentControl x:Name="monContentControl" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Margin="0"/>
    </Grid>
</Window>
