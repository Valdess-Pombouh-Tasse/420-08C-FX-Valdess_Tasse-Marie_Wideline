<Window x:Class="ApplicationGestionProduitCosmetique.Views.FormProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique.Views"
        mc:Ignorable="d"
        Title="FormProduit" Height="600" Width="800" Loaded="Window_Loaded">

    <StackPanel Margin="20">

        <TextBlock x:Name="lblTitre" Text="Produit" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Margin="10"/>

        <StackPanel Orientation="Horizontal">
            <!-- Formulaire à gauche -->
            <StackPanel Width="400">

                <!-- Code -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Code" Width="75" Margin="5"/>
                    <TextBox x:Name="txtCode" Width="125" Margin="5"/>
                </StackPanel>

                <!-- Nom -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Nom" Width="75" Margin="5"/>
                    <TextBox x:Name="txtNom" Width="275" Margin="5,5,0,5"/>
                </StackPanel>

                <!-- Prix -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Prix" Width="75" Margin="5"/>
                    <TextBox x:Name="txtPrix" Width="125" Margin="5"/>
                </StackPanel>

                <!-- Catégorie -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Catégorie" Width="75" Margin="5"/>
                    <ComboBox x:Name="cboCategories" Width="275" Margin="5"/>
                </StackPanel>

                <!-- Quantité -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Quantité" Width="75" Margin="5"/>
                    <TextBox x:Name="txtQuantite" Width="125" Margin="5"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Orientation="Vertical" Margin="5">
                    <Label Content="Description"/>
                    <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

            </StackPanel>

            <!-- Image à droite -->
            <StackPanel>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5">
                    <Image x:Name="imgProduit" Width="250" Height="250"/>
                </Border>
                <Button x:Name="btnAjouterImage" Content="Parcourir ..." HorizontalAlignment="Right" Margin="5" Width="125" Click="btnAjouterImage_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Boutons en bas -->
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="20">
            <Button x:Name="btnAjouterModifierSupprimer" Content="Ajouter / Modifier" Width="150" Margin="5" Click="btnAjouterModifier_Click"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="150" Margin="5" Click="btnAnnuler_Click"/>
        </StackPanel>

    </StackPanel>
</Window>