<Window x:Class="ApplicationGestionProduitCosmetique.FormUtilisateur"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormUtilisateur" Height="600" Width="800" Loaded="Window_Loaded">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/Images/img9.jpg" Stretch="Uniform" />
    </Window.Background>

    <StackPanel Margin="10">
        <GroupBox Header="Liste des utilisateurs">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NOM" FontWeight="Bold" HorizontalAlignment="Left" Width="200" />
                    <TextBlock Text="CODE" FontWeight="Bold" HorizontalAlignment="Left" Width="200" />
                    <TextBlock Text="Role" FontWeight="Bold" HorizontalAlignment="Left" Width="100" />
                </StackPanel>
                <ListBox x:Name="lstUtilisateurs" Width="740" Height="200" FontFamily="Courier New">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NomUtilisateur}" Width="200" />
                                <TextBlock Text="{Binding CodeUtilisateur}" Width="100" />
                                <TextBlock Text="{Binding Role}" Width="200" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Button x:Name="btnAjouter" Content="Ajouter" Width="100" Height="25" Click="btnAjouter_Click" />
            <Button x:Name="btnModifier" Content="Modifier" Width="100" Height="25" Margin="10,0,0,0" Click="btnModifier_Click" />
            <Button x:Name="btnSupprimer" Content="Supprimer" Width="100" Height="25" Margin="10,0,0,0" Click="btnSupprimer_Click" />
        </StackPanel>
    </StackPanel>
</Window>
