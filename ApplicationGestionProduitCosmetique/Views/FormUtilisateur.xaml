<Window x:Class="ApplicationGestionProduitCosmetique.FormUtilisateur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Utilisateurs"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Background>
        <ImageBrush ImageSource="/Resources/Images/img9.jpg" Stretch="UniformToFill" />
    </Window.Background>

    <StackPanel Margin="20">
        <TextBlock Text="Gestion des Utilisateurs" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <Border Background="#AAFFFFFF" Padding="15" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Liste des Utilisateurs"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <DataGrid x:Name="dgUtilisateurs"
                          Height="250"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#F5F5F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"  Binding="{Binding NomUtilisateur}" Width="*"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding CodeUtilisateur}" Width="*"/>
                        <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnAjouter" Content="Ajouter" Width="100" Height="35" Margin="5"
                    Click="btnAjouter_Click" />
            <Button x:Name="btnModifier" Content="Modifier" Width="100" Height="35" Margin="5"
                    Click="btnModifier_Click"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" Width="100" Height="35" Margin="5"
                    Click="btnSupprimer_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
