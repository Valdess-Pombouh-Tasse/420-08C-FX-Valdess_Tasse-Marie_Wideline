<Window x:Class="ApplicationGestionProduitCosmetique.FormVendeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"
        Title="FormVendeur" Height="600" Width="800" Loaded="Window_Loaded">
    <Window.Background>
        <ImageBrush ImageSource="/Resources/Images/img9.jpg" Stretch="Uniform" />
    </Window.Background>
    <Grid>
        <Rectangle Fill="White" Opacity="0.85" RadiusX="20" RadiusY="20"
                   Width="350" Height="320"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel Width="350" Height="320"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20">
            <TextBlock x:Name="tbTitre" Text="Information d'un vendeur" 
                       FontWeight="Bold" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Label Content="Nom" Width="80" FontSize="16" FontWeight="Bold"/>
                <TextBox x:Name="txtNom" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Label Content="Prénom" Width="80" FontSize="16" FontWeight="Bold"/>
                <TextBox x:Name="txtPrenom" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Label Content="Date" Width="80" FontSize="16" FontWeight="Bold"/>
                <DatePicker Name="dpDate" Width="200" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button Name="btnValider" Content="Valider" Width="150" Height="40"
                    Foreground="White" FontWeight="Bold"
                    Background="#2196F3" Click="btnValider_Click_1"
                    HorizontalAlignment="Center" Margin="15"/>
        </StackPanel>
    </Grid>
</Window>
