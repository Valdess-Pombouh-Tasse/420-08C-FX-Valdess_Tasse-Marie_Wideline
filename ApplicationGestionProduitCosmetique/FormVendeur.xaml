<Window x:Class="ApplicationGestionProduitCosmetique.FormVendeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"
        Title="FormVendeur" Height="450" Width="800" Loaded="Window_Loaded">
    <StackPanel>
        <TextBlock x:Name="tbTitre" Text="Information d'un vendeur" FontWeight="Bold"  HorizontalAlignment="Center" Margin="0,20" FontSize="18"></TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Id" Width="80" FontSize="14"></Label>
            <TextBox x:Name="txtId" Width="40"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Nom" Width="80" FontSize="14"></Label>
            <TextBox x:Name="txtNom" Width="200"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Content="Prénom" Width="80" FontSize="14"></Label>
            <TextBox x:Name="txtPrenom" Width="200"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Label Width="80">Date</Label>
            <DatePicker Name="dpDate" Width="150"/>
        </StackPanel>
    </StackPanel>
</Window>
