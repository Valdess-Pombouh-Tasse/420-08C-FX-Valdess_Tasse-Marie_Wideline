<Window x:Class="ApplicationGestionProduitCosmetique.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"
        Title="Accueil" Height="500" Width="800" Background="Pink">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de navigation -->
        <DockPanel Grid.Row="0" Background="#FFDDDDDD" Height="70" LastChildFill="False">
            <TextBlock Text="Cosmetic shop" FontSize="30" FontWeight="ExtraBold"  Foreground="Indigo"  Padding="20,0,0,0"
                      VerticalAlignment="Center" Margin="20"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"  Margin="10">
                <Button Content="Produit et service" Width="120" Margin="8" Foreground="White" FontWeight="Bold" Background="#2196F3"/>
                <Button Content="Carrière" Width="100" Margin="8" Foreground="White" FontWeight="Bold" Background="#2196F3"/>
                <Button Content="Inscription" Width="100" Margin="8" Foreground="White" FontWeight="Bold" Background="#FF4081"/>
            </StackPanel>
        </DockPanel>

        <!-- Contenu principal -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
            <StackPanel Width="350">
                <TextBlock FontSize="24" FontWeight="Bold" Text="Bienvenue sur Cosmetic Shop" Margin="0,0,0,15"/>
                <TextBlock TextWrapping="Wrap" Text="Votre boutique dédiée aux produits cosmétiques adaptés à chaque type de peau. Découvrez nos gammes variées et prenez soin de vous avec des produits de qualité."/>
            </StackPanel>

            <MediaElement Name="videoPlayer" Width="400" Height="300"
              Source="pack://siteoforigin:,,,/Resources/Videos/video3.mp4"
              LoadedBehavior="Play" UnloadedBehavior="Stop"
              Stretch="UniformToFill" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
