<Window x:Class="ApplicationGestionProduitCosmetique.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationGestionProduitCosmetique"
        mc:Ignorable="d"
        Title="Accueil" Height="500" Width="800" Background="#f5f5f5">

    <Grid>

        <TextBlock Text="VEIL OF TONES" FontSize="32" FontWeight="Bold" Foreground="#333"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Grid.Row="0"/>

        <!-- Message de bienvenue -->
        <TextBlock Text="Bienvenue sur veil of tones, votre destination beauté !" FontSize="16" Foreground="#555"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Grid.Row="1"/>

        <TextBlock Text="Découvrez une large gamme de produits cosmétiques adaptés à vos besoins. 
                        Inscrivez-vous pour personnaliser votre expérience et accéder à nos offres exclusives." 
                   FontSize="14" Foreground="#777"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" TextWrapping="Wrap" Grid.Row="2"/>

        <MediaElement Name="videoIntro" Width="600" Height="300" Stretch="Uniform"
                      Source="Resources/videos/video.png" LoadedBehavior="Play" UnloadedBehavior="Stop"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Row="3"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Grid.Row="4">
            <Button Content="S'inscrire" Width="120" Height="40" Margin="10" Background="#FF4081"
                    Foreground="White" FontWeight="Bold" />
            <Button Content="Produit et service" Width="120" Height="40" Margin="10" Background="#2196F3"
                    Foreground="White" FontWeight="Bold" />
            <Button Content="Carriere" Width="120" Height="40" Margin="10" Background="#2196F3"
                    Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
